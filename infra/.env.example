# =============================================================================
# Copy to infra/.env on the Oracle VM and fill in real values.
# NEVER commit the filled-in file -- .gitignore already excludes infra/.env
# =============================================================================

# ---- Image tags (set by CI to the commit SHA; "latest" for manual runs) ----
IMAGE_TAG=latest
REGISTRY=ghcr.io/devdenlab/voice-of-kingdom-all

# ---- Public domain ----
DOMAIN=vokim.ca
ACME_EMAIL=info@vokim.ca

# ---- Django ----
# generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=vokim.ca,www.vokim.ca,backend,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://vokim.ca,https://www.vokim.ca
DJANGO_CORS_ALLOWED_ORIGINS=https://vokim.ca,https://www.vokim.ca
DJANGO_SECURE_SSL_REDIRECT=False   # Caddy already redirects; avoid a double redirect
DJANGO_TIME_ZONE=America/Edmonton
LOG_LEVEL=INFO

# ---- Postgres ----
POSTGRES_DB=vokim
POSTGRES_USER=vokim
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL is derived from the above; override only if using an external DB.

# ---- Redis ----
REDIS_URL=redis://redis:6379/1

# ---- MinIO (S3-compatible object storage -- replaces Cloudinary) ----
MINIO_ROOT_USER=vokim-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MIN_8_CHARS

USE_S3_MEDIA=True
S3_BUCKET=vokim-media
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_QUERYSTRING_AUTH=False
GALLERY_PREFIX=gallery/
# Max size per file for admin gallery uploads (/gallery/manage)
GALLERY_MAX_UPLOAD_MB=15

# Browser-facing paths, proxied by Caddy
MEDIA_URL=/media/
IMGPROXY_BASE_URL=/img

# ---- imgproxy (on-the-fly resize -- replaces Cloudinary transformations) ----
IMGPROXY_MAX_SRC_RESOLUTION=50
IMGPROXY_JPEG_PROGRESSIVE=true
IMGPROXY_ENFORCE_WEBP=true

# ---- Email (Microsoft 365 SMTP) ----
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@vokim.ca
EMAIL_HOST_PASSWORD=CHANGE_ME_ROTATED_APP_PASSWORD
DEFAULT_FROM_EMAIL=info@vokim.ca
ADMIN_EMAIL=info@vokim.ca

# ---- Optional: auto-create Django admin on first boot ----
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=info@vokim.ca
# DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
